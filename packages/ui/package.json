{
  "name": "@2free/ui",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./portfolio": {
      "types": "./src/components/portfolio-workspaces.tsx",
      "default": "./src/components/portfolio-workspaces.tsx"
    },
    "./styles.css": "./src/styles/index.css",
    "./assets/2free-con-fondi.svg": "./src/assets/2free-con-fondi.svg"
  },
  "dependencies": {
    "@2free/core": "workspace:*",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/urbanist": "5.3.0",
    "@gsap/react": "2.1.2",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "gsap": "3.15.0",
    "iconoir-react": "7.11.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.0",
    "@vitest/browser-playwright": "4.1.0",
    "jsdom": "29.1.1",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5",
    "vitest": "4.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  }
}
