{
  "name": "@2free/database",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client.js": "./src/client.ts",
    "./generated/client": "./generated/client/client.js"
  },
  "dependencies": {
    "@2free/core": "workspace:*",
    "@2free/data-provider": "workspace:*",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "7.9.0",
    "tsx": "4.20.6"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "tsx src/migration.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 00000000000000_legacy_pg_baseline",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:snapshot": "tsx src/rollback.ts create",
    "db:snapshot:verify": "tsx src/rollback.ts verify",
    "db:test:up": "docker compose -f ../../compose.test.yml up -d db",
    "db:test:down": "docker compose -f ../../compose.test.yml down -v",
    "pretest": "pnpm db:generate",
    "test": "vitest run --config vitest.config.ts"
  }
}
