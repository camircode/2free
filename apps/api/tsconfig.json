{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*.js": ["src/*.ts"]
    },
    "types": ["node", "vitest/globals"],
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
