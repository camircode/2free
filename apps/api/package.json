{
  "name": "@2free/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@2free/application": "workspace:*",
    "@2free/auth": "workspace:*",
    "@2free/core": "workspace:*",
    "@2free/data-provider": "workspace:*",
    "@2free/database": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "1.6.23",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "express": "5.1.0",
    "pg": "8.22.0",
    "qs": "6.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --outfile=dist/main.js --external:@nestjs/* --external:@thallesp/* --external:@prisma/* --external:better-auth --external:class-transformer --external:class-validator --external:express --external:pg --external:qs --external:reflect-metadata --external:rxjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:source": "tsx src/main.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/express": "5.0.3"
  }
}
