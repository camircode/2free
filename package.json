{
  "name": "2free",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @2free/api --filter @2free/web dev",
    "dev:api": "pnpm --filter @2free/api dev",
    "dev:desktop": "pnpm --filter @2free/desktop dev",
    "dev:landing": "pnpm --filter @2free/landing dev",
    "dev:web": "pnpm --filter @2free/web dev",
    "build:landing": "pnpm --filter @2free/landing build",
    "build:desktop": "pnpm --filter @2free/desktop build",
    "tauri:dev": "pnpm --filter @2free/desktop tauri dev",
    "tauri:build": "pnpm --filter @2free/desktop tauri build",
    "tauri:android:init": "pnpm --filter @2free/desktop tauri android init",
    "tauri:android:dev": "pnpm --filter @2free/desktop tauri android dev",
    "tauri:ios:init": "pnpm --filter @2free/desktop tauri ios init",
    "tauri:ios:dev": "pnpm --filter @2free/desktop tauri ios dev",
    "db:generate": "pnpm --filter @2free/database db:generate",
    "db:migrate": "pnpm --filter @2free/database db:migrate",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f api web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pretypecheck": "pnpm --filter @2free/database db:generate",
    "typecheck": "tsc --noEmit --project packages/core/tsconfig.json && tsc --noEmit --project packages/database/tsconfig.json && tsc --noEmit --project packages/auth/tsconfig.json && tsc --noEmit --project packages/data-provider/tsconfig.json && tsc --noEmit --project packages/application/tsconfig.json && tsc --noEmit --project packages/ui/tsconfig.json && tsc --noEmit --project apps/api/tsconfig.json && pnpm --filter @2free/web typecheck && pnpm --filter @2free/desktop typecheck && pnpm --filter @2free/landing check && tsc --noEmit --project tsconfig.base.json",
    "pretest": "pnpm --filter @2free/database db:generate",
    "test:core": "vitest run --config packages/core/vitest.config.ts packages/core/test --passWithNoTests",
    "test:auth": "pnpm --filter @2free/auth test",
    "test:database": "pnpm --filter @2free/database test",
    "test:data-provider": "vitest run --config packages/data-provider/vitest.config.ts packages/data-provider/test --passWithNoTests",
    "test:runtime": "pnpm --filter @2free/application test && pnpm --filter @2free/api test",
    "test:cloud": "pnpm --filter @2free/data-provider test && pnpm test:runtime",
    "test:ui": "pnpm --filter @2free/ui test",
    "test:desktop": "pnpm --filter @2free/desktop test",
    "test:browser": "pnpm --filter @2free/ui test:browser && pnpm --filter @2free/web test:browser",
    "test": "pnpm test:core && pnpm test:auth && pnpm test:database && pnpm test:data-provider && pnpm test:runtime && pnpm test:ui && pnpm test:desktop",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ci:quality": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium && pnpm check && pnpm test:browser"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.1",
    "prettier": "3.8.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.0"
  }
}
