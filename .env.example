# 2 Free - configuración local de referencia
#
# Inicio rápido:
#   cp .env.example .env
#   docker compose up -d --build
#
# Este archivo contiene valores de DESARROLLO para que Compose funcione sin pasos ocultos.
# No reutilice contraseñas ni claves de este archivo en un servidor público.

# Identidad de la compilación que expone GET /version.
APP_VERSION=0.1.0
BUILD_SHA=local
APP_PROFILE=compose-cloud-dev

# PostgreSQL. Compose construye DATABASE_URL con estos tres valores.
POSTGRES_DB=2free
POSTGRES_USER=2free
POSTGRES_PASSWORD=2free-local-only

# Use esta URL cuando ejecute migraciones o la API directamente desde el host.
# Dentro de Compose, el servicio usa el hostname interno "db" automáticamente.
DATABASE_URL=postgresql://2free:2free-local-only@127.0.0.1:5432/2free

# API NestJS.
API_HOST=0.0.0.0
API_PORT=3001
FINANCE_BOUNDARY_LOCKED=true

# Better Auth requiere al menos 32 caracteres y rechaza placeholders obvios.
# Genere un secreto de producción con: openssl rand -base64 48
BETTER_AUTH_SECRET=development-only-2free-auth-secret-2026
BETTER_AUTH_URL=http://localhost:3001

# Orígenes exactos autorizados para cookies y CORS.
CORS_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# Clave AES-256-GCM de desarrollo: base64 de exactamente 32 bytes.
# Producción: openssl rand -base64 32
# IMPORTANTE: cambiar esta clave sobre datos existentes impide descifrarlos.
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Las rutas seed/reset permanecen desactivadas salvo en un entorno local descartable.
ENABLE_DESTRUCTIVE_DEVELOPMENT_ROUTES=false

# Next.js usa dos URL distintas:
# - API_URL: comunicación servidor a servidor dentro de Compose.
# - NEXT_PUBLIC_API_URL: URL que puede abrir el navegador del usuario.
API_URL=http://api:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Landing Astro opcional: docker compose --profile landing up -d --build
LANDING_PORT=4321
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_SOURCE_URL=https://github.com/camircode/2free
PUBLIC_GITHUB_REPOSITORY=camircode/2free

# Respaldo automático previo a migraciones fuera de Compose (opcional).
# La ruta debe ser escribible y pg_dump/pg_restore deben estar instalados.
# ROLLBACK_SNAPSHOT_PATH=/var/backups/2free/pre-migration.dump

# Tauri lee su valor de nube desde apps/desktop/.env, no desde Compose.
# Consulte apps/desktop/.env.example antes de compilar una distribución personalizada.
